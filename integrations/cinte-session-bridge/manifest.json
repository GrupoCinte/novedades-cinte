{
  "manifest_version": 3,
  "name": "CINTE Atraccion - Conector de sesion",
  "version": "1.2.0",
  "description": "Guarda la sesion de El Empleo o LinkedIn en CINTE tras iniciar sesion en su navegador.",
  "permissions": ["cookies", "storage", "tabs"],
  "host_permissions": [
    "https://www.elempleo.com/*",
    "https://*.elempleo.com/*",
    "https://www.linkedin.com/*",
    "https://*.linkedin.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*.grupocinte.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "https://*.grupocinte.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "externally_connectable": {
    "matches": [
      "http://localhost/*",
      "http://127.0.0.1/*",
      "https://*.grupocinte.com/*"
    ]
  }
}
