{
  "name": "novedades-cinte",
  "version": "1.0.0",
  "private": true,
  "packageManager": "npm@11.12.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "node server.js",
    "dev": "turbo run dev --parallel",
    "dev:backend": "node --watch server.js",
    "dev:watch": "node --watch server.js",
    "dev:shell": "npm run dev -w @cinte/shell",
    "build": "turbo run build",
    "build:frontend": "turbo run build --filter=@cinte/shell...",
    "test": "node --test tests/*.test.js src/notifications/emailNotificationsPublisher.test.js",
    "test:api-smoke": "node --test tests/api.integration.test.js",
    "test:rbac": "node --test tests/rbac.integration.test.js",
    "test:frontend": "turbo run test",
    "test:extractor-ficha": "node --test tests/extractorToFichaMap.test.js tests/mapDynamoItemForPromotion.test.js",
    "test:all": "npm run test && npm run test:frontend",
    "test:new": "node --test tests/cotizadorEngine.test.js tests/utils.extended.test.js tests/wsTicket.test.js",
    "test:ci": "npm run test && npm run test:frontend",
    "audit:runtime": "node src/runtimeAuditCli.js",
    "migrate:pipeline-swat": "node scripts/migrate-pipeline-swat-colaboradores.js",
    "migrate:pipeline-swat:apply": "node scripts/migrate-pipeline-swat-colaboradores.js --apply",
    "migrate:reubicaciones-pipeline": "node scripts/migrate-pipeline-excel-to-reubicaciones.js",
    "migrate:reubicaciones-pipeline:apply": "node scripts/migrate-pipeline-excel-to-reubicaciones.js --apply",
    "seed:conciliaciones-demo": "node scripts/seed-conciliaciones-demo-novedades.js",
    "seed:dev-novedades-demo": "node tests/seedDevNovedadesDemo.js",
    "export:reubicaciones-qa-sql": "node scripts/export-reubicaciones-pipeline-for-qa.js --null-gp-user-id"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1030.0",
    "@aws-sdk/client-dynamodb": "^3.1006.0",
    "@aws-sdk/client-dynamodb-streams": "^3.1006.0",
    "@aws-sdk/client-lambda": "^3.1030.0",
    "@aws-sdk/client-s3": "^3.1006.0",
    "@aws-sdk/lib-dynamodb": "^3.1006.0",
    "@aws-sdk/s3-request-presigner": "^3.1006.0",
    "aws-jwt-verify": "^5.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.1",
    "file-type": "^19.6.0",
    "helmet": "^8.1.0",
    "jose": "^5.10.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.0",
    "pdfkit": "^0.18.0",
    "pg": "^8.20.0",
    "pino": "^9.7.0",
    "ws": "^8.18.3",
    "xlsx": "^0.18.5",
    "zod": "^3.24.2"
  },
  "overrides": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "supertest": "^7.2.2",
    "turbo": "^2.5.4"
  }
}
