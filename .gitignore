# Reglas y estado local del editor (no versionar)
.cursor/

# Dependencias
node_modules/
react-frontend/node_modules/

# Variables de entorno (NO subir)
.env
.env.*
react-frontend/.env
react-frontend/.env.*
!.env.example
!react-frontend/.env.example

# Artefactos de build/test/reportes
artifacts/
react-frontend/dist/
react-frontend/coverage/
react-frontend/playwright-report/
react-frontend/test-results/
react-frontend/.vite/
react-frontend/src/test/
!react-frontend/src/test/setup.js
!react-frontend/src/test/novedadRules.test.js
react-frontend/e2e/
docs/
!docs/
!docs/RBAC_MATRIX.md

# Archivos de sistema
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
logs/*.jsonl
logs/sync-artifacts/

# Archivos temporales
*.tmp
*.temp

# Carpeta de uploads generados
assets/uploads/

# Datos locales/sensibles del proyecto
data/
*.xlsx
*.xls
*.csv
*.tsv
*.parquet
consultores-activos-import-report.csv
manual_merge_*.sql
seed_colaboradores*.sql
**/datasets/**

# Documentación/manuales (solo README permitido)
*.md
!README.md
!**/README.md

# Operaciones locales (no versionar; sync y utilidades se ejecutan desde entorno de desarrollo / repo ops)
scripts/
tooling/

# Scripts y migraciones locales
migrations/
*.sql
*.sh
*.ps1

# Matriz RBAC versionada (excepción a *.md)
!docs/RBAC_MATRIX.md

# Sourcing worker (Atracción de Talento) — secretos y artefactos locales (NO subir)
# Perfil persistente del navegador (contiene Cookies, Login Data, History reales)
sourcing-worker/.elempleo-profile/
sourcing-worker/*-profile/
sourcing-worker/.*-profile/
# Cookies de sesión capturadas (elempleo/linkedin)
sourcing-worker/cookies/
# Logs y artefactos locales del worker
sourcing-worker/logs/
# Entornos virtuales de Python
.venv/
venv/
sourcing-worker/.venv/
sourcing-worker/venv/
# Cachés/compilados de Python
__pycache__/
**/__pycache__/
*.pyc
*.pyo
