FROM node:20-alpine AS build
WORKDIR /app
COPY react-frontend/package*.json ./
RUN npm ci
COPY react-frontend/ .
# Compartido con backend: el frontend importa ../../src/mallaNocturnoCore.js desde src/mallaNocturnoConfig.js
COPY src/mallaNocturnoCore.js /src/mallaNocturnoCore.js
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /usr/share/caddy
COPY react-frontend/Caddyfile.frontend /etc/caddy/Caddyfile
