FROM node:20-alpine AS build
WORKDIR /app
# Flags Vite embebidos en build (QA: true en .env del host al hacer compose build).
ARG VITE_CONCILIACIONES_ENABLED=false
ENV VITE_CONCILIACIONES_ENABLED=$VITE_CONCILIACIONES_ENABLED
ARG VITE_ATRACCION_TALENTO_ENABLED=false
ENV VITE_ATRACCION_TALENTO_ENABLED=$VITE_ATRACCION_TALENTO_ENABLED
COPY react-frontend/package*.json ./
RUN npm ci
COPY react-frontend/ .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /usr/share/caddy
COPY react-frontend/Caddyfile.frontend /etc/caddy/Caddyfile
